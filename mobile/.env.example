# Supabase — sans ces deux variables, l'app tourne sur les mocks de `src/mocks`.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# CoinGecko — facultatif. Sans clé, l'API publique reste utilisable avec un
# quota plus bas ; le cache et le repli hors ligne absorbent la différence.
EXPO_PUBLIC_COINGECKO_API_KEY=

# Diagnostic seulement, et jamais préfixée `EXPO_PUBLIC_` : cette clé contourne
# la RLS. Elle permet à `npm run check:supabase` de compter les membres. Elle
# reste sur votre machine — `.env` est ignoré par git.
SUPABASE_SERVICE_ROLE_KEY=

# Notifications push — posées par `npm run push:setup`, qui les génère.
# La publique entre dans la build ; la privée, sans préfixe EXPO_PUBLIC_, ne
# quitte jamais cette machine et le serveur.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
