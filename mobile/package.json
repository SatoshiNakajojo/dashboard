    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.115.0",
    "expo": "~57.0.20",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~14.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,sql}\"",
    "test": "node --experimental-strip-types --import ./scripts/register-alias.mjs --test \"src/**/__tests__/*.test.ts\" \"supabase/functions/**/__tests__/*.test.ts\" \"scripts/__tests__/*.test.mjs\"",
    "build:web": "expo export --platform web --output-dir dist --clear && node scripts/decorate-web.mjs dist",
    "deploy": "node scripts/deploy-pages.mjs",
    "check:supabase": "node scripts/check-supabase.mjs",
    "members:add": "node scripts/add-members.mjs",
    "push:setup": "node scripts/push-setup.mjs",
    "ci:secrets": "node scripts/ci-secrets.mjs"
  },
  "private": true
}
