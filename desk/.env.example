# Copier en .env. Ne jamais versionner le .env.
#
# AUCUNE CLE PRIVEE ICI. La cle de l'agent wallet appartient au processus
# signer, isole, et n'est lue ni par ce fichier ni par le processus qui parle
# aux modeles. Ce fichier ne connait que des adresses publiques.

# --- posture -----------------------------------------------------------------
# SHADOW  : les mandats sont journalises, aucun ordre n'est emis  (defaut)
# PAPER   : execution simulee contre le carnet reel
# TESTNET : ordres reels sur le testnet Hyperliquid
# LIVE    : argent reel — refuse de demarrer sans agent wallet isole
DESK_MODE=SHADOW
DESK_TESTNET=true
DESK_ASSETS=BTC,ETH

# --- persistance -------------------------------------------------------------
DESK_DB_PATH=desk.db
# DESK_POSTGRES_DSN=postgresql://desk:desk@localhost:5432/desk

# --- supervision -------------------------------------------------------------
# Ne jamais exposer ce port : ce serveur peut arreter le desk.
# Depuis un telephone, passer par un tunnel SSH.
DESK_API_HOST=127.0.0.1
DESK_API_PORT=8787

# --- signer (adresses publiques uniquement) ----------------------------------
# L'agent wallet est approuve par le master via approveAgent. Il peut trader,
# il NE PEUT PAS retirer. Le master signe l'approbation hors ligne.
DESK_AGENT_WALLET_ADDRESS=
DESK_MASTER_WALLET_ADDRESS=
DESK_SIGNER_CAN_WITHDRAW=false

# --- garde-fous --------------------------------------------------------------
DESK_MAX_DAILY_LOSS_PCT=2
DESK_MAX_GROSS_NOTIONAL_USD=1000
DESK_MAX_POSITION_NOTIONAL_USD=500
DESK_RISK_PER_TRADE_PCT=0.5
DESK_MAX_EFFECTIVE_LEVERAGE=3
DESK_PROMPT_ISOLATION_ENABLED=true
