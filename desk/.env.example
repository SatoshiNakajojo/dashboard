# Copier en .env. Ne jamais versionner le .env.
#
# AUCUNE CLE PRIVEE ICI. La cle de l'agent wallet appartient au processus
# signer, isole, et n'est lue ni par ce fichier ni par le processus qui parle
# aux modeles. Ce fichier ne connait que des adresses publiques.

# --- posture -----------------------------------------------------------------
# SHADOW  : les mandats sont journalises, aucun ordre n'est emis  (defaut)
# PAPER   : execution simulee contre le carnet reel
# TESTNET : ordres reels sur le testnet Hyperliquid
# LIVE    : argent reel — refuse de demarrer sans agent wallet isole
DESK_MODE=SHADOW
DESK_TESTNET=true
DESK_ASSETS=BTC,ETH

# --- persistance -------------------------------------------------------------
DESK_DB_PATH=desk.db
# DESK_POSTGRES_DSN=postgresql://desk:desk@localhost:5432/desk

# --- supervision -------------------------------------------------------------
# Ne jamais exposer ce port : ce serveur peut arreter le desk.
# Depuis un telephone, passer par un tunnel SSH.
DESK_API_HOST=127.0.0.1
DESK_API_PORT=8787
# La racine ou l'enregistreur ecrit ses Parquet, si la collecte tourne sur
# CETTE machine. Laisser vide sinon : le panneau TELEMETRIE dira alors que
# la collecte est ailleurs, ce qui est vrai, plutot que zero fichier, ce qui
# ressemblerait a une panne.
DESK_ENREGISTREUR_RACINE=

# --- mode PAPER ---------------------------------------------------------------
# PAPER execute contre le carnet REEL, sans signer ni envoyer quoi que ce soit.
# L'equite de depart reste petite exprès : une equite genereuse produit des
# tailles qu'aucun carnet d'alt n'absorbe, le moteur les tronque, et on finit
# par mesurer la troncature plutot que la strategie.
DESK_PAPER_EQUITY_USD=1000
DESK_PAPER_JOURNAL=data/journal_unlocks.jsonl

# La bande de stop, en points de base. Le defaut [30, 500] vise du BTC
# intraday. La regle des deblocages tient des ALTS pendant six jours : a 5 %,
# le stop se fait balayer par le bruit avant la fin de la fenetre, et on ne
# trade plus la strategie mesuree. Desserrer ici est un choix explicite, et
# l'effet du stop sur l'edge n'est PAS mesure — voir README.
DESK_MIN_STOP_DISTANCE_BPS=30
DESK_MAX_STOP_DISTANCE_BPS=1600

# --- signer (adresses publiques uniquement) ----------------------------------
# L'agent wallet est approuve par le master via approveAgent. Il peut trader,
# il NE PEUT PAS retirer. Le master signe l'approbation hors ligne.
DESK_AGENT_WALLET_ADDRESS=
DESK_MASTER_WALLET_ADDRESS=
DESK_SIGNER_CAN_WITHDRAW=false

# --- garde-fous --------------------------------------------------------------
DESK_MAX_DAILY_LOSS_PCT=2
DESK_MAX_GROSS_NOTIONAL_USD=1000
DESK_MAX_POSITION_NOTIONAL_USD=500
DESK_RISK_PER_TRADE_PCT=0.5
DESK_MAX_EFFECTIVE_LEVERAGE=3
DESK_PROMPT_ISOLATION_ENABLED=true
