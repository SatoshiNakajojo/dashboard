# /etc/systemd/system/regles-figees.service
#
# Declenche par regles-figees.timer. Voir deploy/README.md.
#
[Unit]
Description=Inscrit les signaux des regles de prix figees
Documentation=https://github.com/SatoshiNakajojo/dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=desk
Group=desk
WorkingDirectory=/opt/desk/src/desk
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/desk/.venv/bin/python scripts/journal_regles.py
TimeoutStartSec=900

# Pas de Restart : un oneshot qui echoue doit RESTER en echec. Un service qui
# se relance efface la trace de la panne, et `systemctl status` dirait
# « actif » sur un journal qui n'a rien inscrit depuis un mois.

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/desk/src/desk/data /opt/desk/src/desk/.cache
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=1G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=regles-figees

[Install]
WantedBy=multi-user.target
